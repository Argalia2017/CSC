	<Type Name="CSC::Buffer&lt;*&gt;">
		<Intrinsic Name="at" Expression="(($T1*)((__int64)this+i))" >
			<Parameter Name="i" Type="__int32"/>
		</Intrinsic>
		<Expand HideRawView="true">
			<Item Name="[size]">sizeof(mBuffer)/sizeof($T1)</Item>
			<Item Name="[step]">sizeof($T1)</Item>
			<IndexListItems Optional="true">
				<Size>sizeof(mBuffer)/sizeof($T1)</Size>
				<ValueNode>*at($i)</ValueNode>
			</IndexListItems>
		</Expand>
